{
    "sdd": {
    },
    "ai": {
        "ai@1": {
            "model": "claude-opus-5",
            "provider": "claude"
        },
        "mcpServers": {
            "ado": {
                "command": "npx",
                "args": [
                    "-y",
                    "@azure-devops/mcp@2.9.0",
                    "Splitx",
                    "--authentication",
                    "azcli"
                ],
                "env": {
                    "ado_mcp_project":"Core"
                },
                "requiresWarmStartup": true
            }
        }
    },
    "env": {
        "allowed": []
    }
}
